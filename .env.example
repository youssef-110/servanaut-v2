# ============================================================
# SERVANAUT V2 — Environment Variables
# Copy this file to backend/.env and fill in your keys.
# Every key is optional: missing keys degrade gracefully
# (in-memory storage, heuristic AI, demo market data).
# ============================================================

# Supabase — database (supabase.com → Project Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — AI summaries, briefings, insights (platform.openai.com/api-keys)
OPENAI_API_KEY=

# News
NEWS_API_KEY=           # newsapi.org — free at newsapi.org/register
GUARDIAN_API_KEY=       # open-platform.theguardian.com — free registration

# Market Data
ALPHA_VANTAGE_KEY=      # alphavantage.co/support/#api-key — free

# Email
RESEND_API_KEY=         # resend.com — free tier 3000 emails/month
DIGEST_FROM_EMAIL=      # optional; defaults to "SERVANAUT <onboarding@resend.dev>"

# GitHub (optional but recommended — raises rate limits for trending/org data)
GITHUB_TOKEN=           # github.com/settings/tokens — no scopes needed for public data

# Product Hunt (optional)
PRODUCT_HUNT_TOKEN=     # api.producthunt.com/v2/oauth/applications

# App
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# ------------------------------------------------------------
# Frontend (optional) — copy to frontend/.env if you want the
# browser to talk to Supabase directly (realtime extensions).
# ------------------------------------------------------------
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_API_URL=          # defaults to /api (Vite dev proxy → localhost:3001)
